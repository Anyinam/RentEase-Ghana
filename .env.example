FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
DATABASE_URL=sqlite:///rentease.db
DB_PASSWORD=set-a-unique-local-database-password
REDIS_PASSWORD=replace-with-a-random-password
REDIS_URL=redis://:replace-with-a-random-password@redis:6379/0
CELERY_BROKER_URL=redis://:replace-with-a-random-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:replace-with-a-random-password@redis:6379/2
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
UPLOAD_FOLDER=/app/uploads
MAX_CONTENT_LENGTH=16777216
FRONTEND_ORIGIN=http://localhost:5173
